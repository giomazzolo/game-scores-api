				{
					"name": "List Games",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();\r",
									"const gameIds = response.map(game => game.id);\r",
									"const selectedGameId = gameIds[0];\r",
									"\r",
									"// Save all gameIds and save the first gameId as selectedGameId_temp\r",
									"\r",
									"pm.environment.set(\"selectedGameId_temp\", selectedGameId);\r",
									"pm.environment.set('gameIds', gameIds);\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{address}}/games"
					},
					"response": []
				},
